// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum VisaCategory {
  STUDENT
  JOB_SEEKER
  MEDICAL
  AUSBILDUNG
}

enum ApplicationStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  NEEDS_REVISION
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  phone           String?
  birthDate       DateTime?
  nationality     String?
  role            Role      @default(USER)
  locale          String    @default("en")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  applications Application[]

  name          String
  emailVerified Boolean   @default(false)
  image         String?
  sessions      Session[]
  accounts      Account[]

  @@map("users")
}


model Application {
  id             String            @id @default(uuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  category       VisaCategory
  status         ApplicationStatus @default(DRAFT)
  currentStep    Int               @default(0)
  fullNameLatin  String?
  passportNumber String?
  passportExpiry DateTime?
  data           Json              @default("{}")
  // Timestamp, not a boolean: an audit trail proving *when* explicit consent
  // was given for sensitive documents (criminal record, medical report — see
  // needsSensitiveDataConsent() in src/lib/wizard.ts), not just that it was.
  // Set once, on first consent, and never overwritten by a later save.
  sensitiveDataConsentAt DateTime?
  submittedAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  documents      Document[]

  // "One application per category per user", enforced by the database.
  // A check-then-insert in the Server Action is not enough: two rapid taps can
  // both pass the check before either row lands. Only this constraint cannot
  // lose that race.
  //
  // This REPLACES @@index([userId]). A composite index is usable for queries
  // that filter on a leading subset of its columns, so lookups by userId alone
  // (the dashboard list) are still indexed. Keeping both would mean maintaining
  // a second index on every write for nothing.
  @@unique([userId, category])
  @@map("applications")
}

enum ScanStatus {
  PENDING
  CLEAN
  INFECTED
  FAILED
  /// The file was never scanned because it exceeded the scanner's size limit
  /// (SCAN_MAX_BYTES in src/lib/uploads.ts — 3 MB on Cloudmersive's free
  /// tier). Distinct from FAILED, which means the service WAS reached and
  /// errored. In practice this only ever applies to large PDFs: images are
  /// re-encoded down to a few hundred KB before scanning, so they always fit.
  ///
  /// This must stay visible to admins in the review UI. Storing an unscanned
  /// file is only defensible if the person about to open it can see that it
  /// was not checked.
  SKIPPED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  NEEDS_REVISION
}

model Document {
  id              String       @id @default(uuid())
  applicationId   String
  application     Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  requirementCode String
  fileName        String
  storageKey      String
  mimeType        String
  sizeBytes       Int
  scanStatus      ScanStatus   @default(PENDING)
  reviewStatus    ReviewStatus @default(PENDING)
  adminNote       String?
  version         Int          @default(1)
  uploadedAt      DateTime     @default(now())

  // One row per requirement per application. A re-upload REPLACES this row
  // (storageKey swapped, version incremented) rather than adding a second
  // one — otherwise checklistProgress()'s uploadedCodes check still works,
  // but _count.documents on the dashboard would over-count, and the old R2
  // object would be orphaned (paying storage forever for a superseded file).
  //
  // This REPLACES @@index([applicationId]) for the same reason the
  // Application model's composite unique does: a composite index is usable
  // for a leading-column lookup, so "all documents for this application" is
  // still indexed.
  @@unique([applicationId, requirementCode])
  @@map("documents")
}

enum AuditAction {
  DOCUMENT_DOWNLOADED
  DOCUMENT_REVIEWED
  APPLICATION_DECIDED
  /// An admin sent an already-decided application back for review, undoing a
  /// prior outcome. Deliberately its own action rather than another
  /// APPLICATION_DECIDED: reversing a decision the applicant was already
  /// told about is the kind of event that should be trivially findable.
  APPLICATION_REOPENED
  APPLICATION_EXPORTED
  ACCOUNT_DELETED
  RETENTION_PURGE
}

/// Accountability trail (GDPR Art. 5(2) / Art. 30) — who touched whose
/// personal data, and when. Chiefly staff access: this portal holds
/// passports, criminal-record extracts and medical reports, so "which admin
/// opened this file" is the question that actually needs answering later.
///
/// NOTE THE DELIBERATE ABSENCE OF RELATIONS. `actorUserId` / `subjectUserId`
/// are plain strings, NOT foreign keys, specifically so that deleting a user
/// does NOT cascade these rows away. If they were relations with the
/// `onDelete: Cascade` used everywhere else in this schema, erasing an
/// account would also erase the record that an admin had accessed that
/// person's passport — destroying the audit trail exactly when it matters
/// most. Retaining these entries after erasure is defensible under
/// Art. 17(3)(b) precisely because they hold no personal data: only opaque
/// ids that, once the user is gone, no longer resolve to a person.
model AuditLog {
  id        String      @id @default(uuid())
  action    AuditAction
  /// The admin (or system) that acted. Null for automated jobs.
  actorUserId   String?
  /// Whose data was touched. Kept for "show me everything about this person",
  /// and intentionally left dangling once that person is deleted.
  subjectUserId String?
  /// "document" | "application" | "user" — plus its id. Strings, not FKs.
  targetType String
  targetId   String
  /// Small, non-identifying context (decision made, file count, category).
  /// Never put names, emails or file contents in here.
  metadata Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([subjectUserId])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  issuer                String
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([issuer, accountId], map: "account_issuer_accountId_uidx")
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}
