// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum VisaCategory {
  STUDENT
  JOB_SEEKER
  MEDICAL
  AUSBILDUNG
}

enum ApplicationStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  NEEDS_REVISION
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  phone           String?
  birthDate       DateTime?
  nationality     String?
  role            Role      @default(USER)
  locale          String    @default("en")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  applications Application[]

  name          String
  emailVerified Boolean   @default(false)
  image         String?
  sessions      Session[]
  accounts      Account[]

  @@map("users")
}


model Application {
  id             String            @id @default(uuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  category       VisaCategory
  status         ApplicationStatus @default(DRAFT)
  currentStep    Int               @default(0)
  fullNameLatin  String?
  passportNumber String?
  passportExpiry DateTime?
  data           Json              @default("{}")
  submittedAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  documents      Document[]

  // "One application per category per user", enforced by the database.
  // A check-then-insert in the Server Action is not enough: two rapid taps can
  // both pass the check before either row lands. Only this constraint cannot
  // lose that race.
  //
  // This REPLACES @@index([userId]). A composite index is usable for queries
  // that filter on a leading subset of its columns, so lookups by userId alone
  // (the dashboard list) are still indexed. Keeping both would mean maintaining
  // a second index on every write for nothing.
  @@unique([userId, category])
  @@map("applications")
}

enum ScanStatus {
  PENDING
  CLEAN
  INFECTED
  FAILED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  NEEDS_REVISION
}

model Document {
  id              String       @id @default(uuid())
  applicationId   String
  application     Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  requirementCode String
  fileName        String
  storageKey      String
  mimeType        String
  sizeBytes       Int
  scanStatus      ScanStatus   @default(PENDING)
  reviewStatus    ReviewStatus @default(PENDING)
  adminNote       String?
  version         Int          @default(1)
  uploadedAt      DateTime     @default(now())

  // One row per requirement per application. A re-upload REPLACES this row
  // (storageKey swapped, version incremented) rather than adding a second
  // one — otherwise checklistProgress()'s uploadedCodes check still works,
  // but _count.documents on the dashboard would over-count, and the old R2
  // object would be orphaned (paying storage forever for a superseded file).
  //
  // This REPLACES @@index([applicationId]) for the same reason the
  // Application model's composite unique does: a composite index is usable
  // for a leading-column lookup, so "all documents for this application" is
  // still indexed.
  @@unique([applicationId, requirementCode])
  @@map("documents")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  issuer                String
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([issuer, accountId], map: "account_issuer_accountId_uidx")
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}
